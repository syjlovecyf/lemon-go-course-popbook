{
  "name": "lemon-course-popbook",
  "version": "1.0.0",
  "private": true,
  "description": "柠檬说棋 · 一堂好课，是怎样磨出来的",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "remotion studio --no-open",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types scripts/validate.mjs",
    "render": "remotion render src/index.ts LemonCourse out/lemon-course.mp4 --concurrency=2 --crf=18",
    "still": "remotion still src/index.ts LemonCourse out/cover.png --frame=1020"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/media": "4.0.536",
    "@remotion/fonts": "4.0.536",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "19.1.16",
    "typescript": "5.9.3"
  }
}